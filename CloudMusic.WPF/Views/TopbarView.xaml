<UserControl
    x:Class="CloudMusic.WPF.Views.TopbarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CloudMusic.WPF.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Margin="0,0,8,0"
            Padding="8,12"
            Background="Transparent"
            BorderBrush="#E2E5E9"
            BorderThickness="0.8"
            CornerRadius="8">
            <svgc:SvgIcon
                Width="12"
                Height="12"
                UriSource="/Assets/Icons/Topbar/back.svg" />
        </Border>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Border
                MinWidth="260"
                MaxWidth="260"
                Padding="0"
                BorderBrush="#E2E5E9"
                BorderThickness="0.8"
                CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#EBF0FB" />
                                    <GradientStop Offset="1" Color="#F7EEF7" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=InputTextBox}" Value="True">
                                <Setter Property="Background" Value="#F7F9FC" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Padding="12,4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                        <svgc:SvgIcon
                            Grid.Column="0"
                            Width="12"
                            Height="12"
                            UriSource="/Assets/Icons/Topbar/search.svg" />
                    </Button>
                    <TextBox
                        x:Name="InputTextBox"
                        Grid.Column="2"
                        Margin="0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="16"
                        HorizontalScrollBarVisibility="Hidden"
                        TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel
            Grid.Column="3"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <!--  账号、功能按钮、最小化、最大化、关闭  -->
            <svgc:SvgIcon
                Width="12"
                Height="12"
                Margin="0,0,16,0"
                UriSource="/Assets/Icons/Topbar/minimize.svg" />
            <svgc:SvgIcon
                Width="12"
                Height="12"
                Margin="0,0,16,0"
                UriSource="/Assets/Icons/Topbar/maximize.svg" />
            <svgc:SvgIcon
                Width="12"
                Height="12"
                UriSource="/Assets/Icons/Topbar/close.svg" />
        </StackPanel>
    </Grid>
</UserControl>
