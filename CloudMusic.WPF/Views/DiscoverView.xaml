<UserControl
    x:Class="CloudMusic.WPF.Views.DiscoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:CloudMusic.WPF.Views.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CloudMusic.WPF.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid
                            MinWidth="100"
                            MinHeight="180"
                            Columns="5" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem>
                    <components:DailyRecommendationCard
                        MinHeight="180"
                        Margin="4"
                        SizeChanged="Card_SizeChanged" />
                </ListBoxItem>

                <ListBoxItem>
                    <components:DailyRecommendationCard
                        MinHeight="180"
                        Margin="4"
                        SizeChanged="Card_SizeChanged" />
                </ListBoxItem>

                <ListBoxItem>
                    <components:DailyRecommendationCard
                        MinHeight="180"
                        Margin="4"
                        SizeChanged="Card_SizeChanged" />
                </ListBoxItem>
            </ListBox>
        </Grid>
    </ScrollViewer>
</UserControl>
