<Window
    x:Class="CloudMusic.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CloudMusic.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:CloudMusic.WPF.Views"
    xmlns:vm="clr-namespace:CloudMusic.WPF.ViewModels"
    Title="MainWindow"
    Width="1056"
    Height="808"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Background="Transparent"
    mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="32"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DiscoverViewModel}">
            <views:DiscoverView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FeaturedViewModel}">
            <views:FeaturedView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PodcastViewModel}">
            <views:PodcastView />
        </DataTemplate>
    </Window.Resources>

    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:SidebarView Grid.Column="0" DataContext="{Binding SidebarVM}" />
            <Border
                Grid.Column="1"
                Padding="32,28,32,0"
                Background="#F7F9FC">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <views:TopbarView Grid.Row="0" Margin="0,0,0,32"/>
                    <ContentControl Grid.Row="1" Content="{Binding Navigation.CurrentPage}" />
                </Grid>
            </Border>
        </Grid>
    </Border>

</Window>
