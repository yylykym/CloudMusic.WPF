<UserControl
    x:Class="CloudMusic.WPF.Views.Components.PlayerBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CloudMusic.WPF.Views.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border Padding="0" Background="#FFFFFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ProgressBar
                Height="5"
                Maximum="{Binding DurationSeconds}"
                Minimum="0"
                Value="{Binding PositionSeconds}" />
            <Grid Grid.Row="1" Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PositionSeconds, StringFormat={}{0:F1} 秒}" />
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Command="{Binding StartCommand}"
                    Content="播放" />
                <TextBlock Grid.Column="2" Text="更多" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
