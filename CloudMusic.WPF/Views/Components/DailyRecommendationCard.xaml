<UserControl
    x:Class="CloudMusic.WPF.Views.Components.DailyRecommendationCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    x:Name="Root"
    d:DesignHeight="180"
    d:DesignWidth="140"
    mc:Ignorable="d">
    <Grid
        Background="Transparent"
        MouseEnter="CardSurface_MouseEnter"
        MouseLeave="CardSurface_MouseLeave"
        SizeChanged="CardSurface_SizeChanged">
        <Grid.Clip>
            <RectangleGeometry
                x:Name="CardClip"
                RadiusX="8"
                RadiusY="8" />
        </Grid.Clip>

        <Image Source="/Assets/Images/demo.webp" Stretch="UniformToFill" />

        <!--  悬停时加深封面，不改变卡片布局。  -->
        <Border
            x:Name="HoverShade"
            Background="#D9343434"
            IsHitTestVisible="False"
            Opacity="0" />

        <!--  普通状态下，描述显示在底部。  -->
        <Border
            x:Name="NormalDescription"
            Padding="8"
            VerticalAlignment="Bottom"
            Background="#343434"
            IsHitTestVisible="False">
            <TextBlock
                x:Name="DescriptionText"
                Height="32"
                FontSize="12"
                Foreground="White"
                LineHeight="16"
                LineStackingStrategy="BlockLineHeight"
                Text="每日推荐 | 从你喜欢的音乐听起"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </Border>

        <!--  悬停详情叠在封面上，不占用额外布局空间。  -->
        <Grid
            x:Name="HoverDetails"
            Margin="8,36,8,8"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="DetailsOffset" Y="12" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Height="32"
                FontSize="12"
                Foreground="White"
                LineHeight="16"
                LineStackingStrategy="BlockLineHeight"
                Text="{Binding Text, ElementName=DescriptionText}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <!--  示例歌曲，后续替换为真实数据绑定。  -->
                <StackPanel VerticalAlignment="Bottom">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Height" Value="22" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="#DDFFFFFF" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock Text="1  FINAL FINAL" />
                    <TextBlock Text="2  Hello Bye" />
                    <TextBlock Text="3  Nobody's Love" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="播放每日推荐"
                    Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <Path
                                    Width="22"
                                    Height="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M 0,0 L 22,13 L 0,26 Z"
                                    Fill="White"
                                    Stretch="Uniform" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>

        <!--  标题最后绘制，始终在遮罩上面。  -->
        <StackPanel
            Margin="0,4,0,0"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Orientation="Horizontal">
            <svgc:SvgIcon
                Width="16"
                Height="16"
                Margin="8,0,8,0"
                Fill="White"
                UriSource="/Assets/Brand/logo.svg" />
            <TextBlock
                FontSize="16"
                Foreground="White"
                Text="每日推荐" />
        </StackPanel>
    </Grid>
</UserControl>
