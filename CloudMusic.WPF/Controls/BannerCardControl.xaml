<UserControl x:Class="CloudMusic.WPF.Controls.BannerCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CloudMusic.WPF.Controls"
             mc:Ignorable="d" 
             x:Name="Root"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             d:DesignHeight="180" d:DesignWidth="100">
    <Border
        Background="Transparent"
        ClipToBounds="True">
        <Grid>
            <Image Source="{Binding CoverImage, ElementName=Root}" Stretch="UniformToFill"  />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding CardTitle, ElementName=Root}" />
                <TextBlock Grid.Row="2" Text="每日推荐,从走走走听起" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
